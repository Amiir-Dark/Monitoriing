[Unit]
Description=NodeWatch Central Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nodewatch
ExecStart=/opt/nodewatch/nodewatch -port 8080 -db /opt/nodewatch/data/nodewatch.db -dist /opt/nodewatch/dist
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nodewatch

# Security Sandboxing
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
